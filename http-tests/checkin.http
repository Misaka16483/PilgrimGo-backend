### ===========================================================
### PilgrimGo 打卡/点赞接口测试
###
### 使用前：右上角选择环境 = local
### 顺序：
###   1) 注册（首次跑一次即可，已存在会 400，忽略）
###   2) 登录（自动把 token 存到 global）
###   3) 任意点击下方接口
###
### 全局变量：{{token}} {{checkInId}}
### ===========================================================


### 1. 注册测试用户（首次执行一次）
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}",
  "nickname": "{{nickname}}"
}

> {%
    if (response.status === 200 && response.body.code === 200) {
        client.global.set("token", response.body.data.token);
        client.global.set("userId", response.body.data.user.id);
        client.log("注册成功，token 已存入 global");
    } else {
        client.log("注册失败（可能已存在），请运行下面的登录");
    }
%}


### 2. 登录 → 自动捕获 token
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {%
    client.test("登录成功", function () {
        client.assert(response.status === 200, "HTTP 状态非 200");
        client.assert(response.body.code === 200, "业务 code 非 200：" + response.body.message);
    });
    client.global.set("token", response.body.data.token);
    client.global.set("userId", response.body.data.user.id);
    client.log("token = " + response.body.data.token);
    client.log("userId = " + response.body.data.user.id);
%}


### 3. 获取当前登录用户信息（验证 token 有效）
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}


### 4. 查看 feed —— 记下任一条 id 作为下面点赞目标
GET {{baseUrl}}/api/v1/checkins/feed?page=1&size=10
Authorization: Bearer {{token}}

> {%
    if (response.body.data && response.body.data.length > 0) {
        const first = response.body.data[0];
        client.global.set("checkInId", first.id);
        client.log("已把 feed 第一条 id=" + first.id + " 存入 {{checkInId}}");
        client.log("初始 likeCount=" + first.likeCount + ", liked=" + first.liked);
    } else {
        client.log("feed 为空，先用接口 5 创建一条打卡");
    }
%}


### 5. 创建打卡（feed 为空时用）—— spotId 改成你数据库里真实存在的值
POST {{baseUrl}}/api/v1/checkins
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "spotId": 1,
  "photoUrl": "https://example.com/test.jpg",
  "content": "测试打卡（来自 http-tests）"
}

> {%
    if (response.body.code === 200) {
        client.global.set("checkInId", response.body.data.id);
        client.log("已创建打卡 id=" + response.body.data.id);
    }
%}


### 6. 第一次点赞 → 期望 data: true，like_count +1
POST {{baseUrl}}/api/v1/checkins/{{checkInId}}/like
Authorization: Bearer {{token}}

> {%
    client.test("第一次点赞应返回 true", function () {
        client.assert(response.body.code === 200, "业务 code 非 200");
        client.assert(response.body.data === true, "期望 true，实际：" + response.body.data);
    });
%}


### 7. 第二次点赞（同一用户）→ 期望 data: false（取消）
POST {{baseUrl}}/api/v1/checkins/{{checkInId}}/like
Authorization: Bearer {{token}}

> {%
    client.test("再次点赞应返回 false（取消）", function () {
        client.assert(response.body.code === 200, "业务 code 非 200");
        client.assert(response.body.data === false, "期望 false，实际：" + response.body.data);
    });
%}


### 8. 第三次点赞（恢复点赞状态）→ true
POST {{baseUrl}}/api/v1/checkins/{{checkInId}}/like
Authorization: Bearer {{token}}


### 9. 再查 feed —— 验证目标记录 liked=true，likeCount 已 +1
GET {{baseUrl}}/api/v1/checkins/feed?page=1&size=10
Authorization: Bearer {{token}}

> {%
    const target = response.body.data.find(c => c.id == client.global.get("checkInId"));
    client.test("目标记录 liked=true", function () {
        client.assert(target, "feed 找不到 checkInId=" + client.global.get("checkInId"));
        client.assert(target.liked === true, "期望 liked=true，实际：" + target.liked);
    });
    client.log("当前 likeCount=" + target.likeCount + ", liked=" + target.liked);
%}


### 10. 按景点查打卡
GET {{baseUrl}}/api/v1/checkins?spotId=1&page=1&size=10
Authorization: Bearer {{token}}
